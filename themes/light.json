  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#66707b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "support.class.console",
        "support.variable.object"
      ],
      "settings": {
        "foreground": "#24292f"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.object.property",
        "meta.object-literal.key string"
      ],
      "settings": {
        "foreground": "#1b1f24"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.control",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#b8443a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "keyword.operator.negation.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.definition.group.assertion.regexp",
        "keyword.operator.lookahead.regexp"
      ],
      "settings": {
        "foreground": "#57606a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.constant",
        "variable.other.object",
        "meta.object-binding-pattern-variable variable.object.property"
      ],
      "settings": {
        "foreground": "#3d6a8a"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "meta.parameters meta.object-binding-pattern-variable variable"
      ],
      "settings": {
        "foreground": "#9b4f96"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7b3ff2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#0969da"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3a7d44"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9a6700"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9a6700"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#57606a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.binding-pattern.object",
        "punctuation.definition.dictionary",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#1b1f24",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.brace.round",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.begin.bracket.round",
        "punctuation.definition.end.bracket.round",
        "storage.type.function.arrow",
        "punctuation.section.function",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#1b1f24",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b8443a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0969da",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#0969da"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#7b3ff2",
    "method": "#7b3ff2",
    "class": "#0969da",
    "class.defaultLibrary": "#0969da",
    "type": "#0969da",
    "interface": "#0969da",
    "typeParameter": "#0969da",
    "enum": "#0969da",
    "variable": "#3d6a8a",
    "variable.defaultLibrary": "#24292f",
    "parameter": "#9b4f96",
    "property": "#1b1f24",
    "namespace": "#24292f"
  }
}
