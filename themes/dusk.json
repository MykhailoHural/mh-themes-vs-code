{
  "name": "MH Dusk",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1b2230",
    "editor.foreground": "#d5dce5",
    "editor.lineHighlightBackground": "#252d3d",
    "editor.selectionBackground": "#61d6f533",
    "editorCursor.foreground": "#61d6f5",
    "editorLineNumber.foreground": "#5f6b82",
    "editorLineNumber.activeForeground": "#d5dce5",
    "editorIndentGuide.background1": "#303a4d",
    "editorWhitespace.foreground": "#303a4d",
    "editorGroupHeader.tabsBackground": "#1b2230",
    "tab.activeBackground": "#1b2230",
    "tab.inactiveBackground": "#1b2230",
    "tab.activeBorderTop": "#61d6f5",
    "tab.border": "#303a4d",
    "sideBar.background": "#1b2230",
    "sideBar.border": "#303a4d",
    "activityBar.background": "#1b2230",
    "activityBar.border": "#303a4d",
    "titleBar.activeBackground": "#1b2230",
    "titleBar.border": "#303a4d",
    "statusBar.background": "#1b2230",
    "statusBar.foreground": "#7f899a",
    "statusBar.border": "#303a4d",
    "panel.background": "#1b2230",
    "panel.border": "#303a4d",
    "terminal.background": "#1b2230",
    "terminal.foreground": "#d5dce5",
    "focusBorder": "#61d6f5",
    "button.background": "#61d6f5",
    "textLink.foreground": "#61d6f5",
    "badge.background": "#61d6f5",
    "editorBracketHighlight.foreground1": "#d5dce5",
    "editorBracketHighlight.foreground2": "#d5dce5",
    "editorBracketHighlight.foreground3": "#d5dce5",
    "editorBracketHighlight.foreground4": "#d5dce5",
    "editorBracketHighlight.foreground5": "#d5dce5",
    "editorBracketHighlight.foreground6": "#d5dce5",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff9b75",
    "editorBracketMatch.background": "#61d6f533",
    "editorBracketMatch.border": "#303a4d",
    "editorBracketPairGuide.activeBackground1": "#303a4d"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f899a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "support.class.console",
        "support.variable.object"
      ],
      "settings": {
        "foreground": "#d5dce5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.object.property",
        "meta.object-literal.key string"
      ],
      "settings": {
        "foreground": "#d9ceb2"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.control",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#ff9b75",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "keyword.operator.negation.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.definition.group.assertion.regexp",
        "keyword.operator.lookahead.regexp"
      ],
      "settings": {
        "foreground": "#d5dce5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.constant",
        "variable.other.object",
        "meta.object-binding-pattern-variable variable.object.property"
      ],
      "settings": {
        "foreground": "#c6dcf2"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "meta.parameters meta.object-binding-pattern-variable variable"
      ],
      "settings": {
        "foreground": "#c6dcf2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#82afff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#55d6c8"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a8e66b"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#c5a0ff"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#c5a0ff"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#55d6c8"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#d5dce5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.binding-pattern.object",
        "punctuation.definition.dictionary",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#d5dce5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.brace.round",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.begin.bracket.round",
        "punctuation.definition.end.bracket.round",
        "storage.type.function.arrow",
        "punctuation.section.function",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#d5dce5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff9b75"
      }
    },
    {
      "scope": [
        "support.class",
        "support.class.builtin",
        "support.class.console"
      ],
      "settings": {
        "foreground": "#82afff"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp",
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp"
      ],
      "settings": {
        "foreground": "#b5d989"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#61d6f5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#55d6c8"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#82afff",
    "method": "#61d6f5",
    "class": "#55d6c8",
    "class.defaultLibrary": "#82afff",
    "type": "#55d6c8",
    "interface": "#55d6c8",
    "typeParameter": "#55d6c8",
    "enum": "#55d6c8",
    "variable": "#c6dcf2",
    "variable.defaultLibrary": "#d5dce5",
    "parameter": "#c6dcf2",
    "property": "#d9ceb2",
    "namespace": "#d5dce5"
  }
}
